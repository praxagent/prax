# Flask / General
FLASK_SECRET_KEY=change-me
SESSION_TYPE=filesystem
NGROK_URL=https://example.ngrok-free.app
DEBUG=False
LOG_PATH=app.log
# Web-search backend. 'legacy' = the sunset duckduckgo-search package (prior
# behaviour; its backends have been observed hanging). RECOMMENDED: 'ddgs' —
# the actively-maintained successor, no API key, titled+linked snippets.
# Web-search backend. Keyless: legacy (default) | ddgs (both scrape
# DuckDuckGo's frontend — fragile). Keyed real Search APIs (reliable):
# brave | tavily | jina. A keyed provider with no key returns an actionable
# message instead of failing silently.
SEARCH_PROVIDER=ddgs
# BRAVE_API_KEY=            # for SEARCH_PROVIDER=brave  (brave.com/search/api)
# TAVILY_API_KEY=           # for SEARCH_PROVIDER=tavily (tavily.com; agent-optimised, includes an answer)
# SERPER_DEV_API_KEY=       # for SEARCH_PROVIDER=serper (serper.dev; Google results, prepaid, includes an answer box)
# jina uses JINA_API_KEY above (search endpoint REQUIRES the key — reader is keyless, search is not)
# SEARCH_MAX_RESULTS=6
# Wall-clock timeout (seconds) for the web-search tool. The DuckDuckGo search
# backends occasionally hang instead of erroring, which parks a whole turn
# indefinitely. Recommended: 60. 0 (default) = no timeout (prior behavior).
# WEB_SEARCH_TIMEOUT_S=60
# Runtime location for the metacognitive learned-state store. Defaults to a
# gitignored runtime/ subdir of the shipped seed profiles, so live learning
# never dirties the tracked seeds. Set to relocate it (e.g. a mounted volume).
# METACOGNITIVE_DIR=
PORT=5001
# Interface Prax binds. Default 127.0.0.1 (loopback only) — secure by default: a
# host install isn't network-reachable; a same-host reverse proxy (tailscale
# serve / nginx / Caddy) still reaches it via localhost. Set 0.0.0.0 ONLY behind
# an authenticating proxy + firewall (see docs/security/network-exposure.md).
# The container image already sets this to 0.0.0.0 (its boundary is the published
# port). TeamWork has the matching TEAMWORK_HOST knob.
# PRAX_HOST=127.0.0.1
DATABASE_NAME=conversations.db
# SQLite identity DB (users + their linked channel identities), relative to the
# working directory.
# IDENTITY_DB=identity.db

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ROOT_PHONE_NUMBER=+15551234567

# Ngrok (for docker-compose auto-tunnel — Twilio voice/SMS only)
# Twilio's servers must reach Prax's webhook routes from the public internet.
# Course/note publishing and per-file sharing ride on Tailscale (see below) or
# the gated /shared/<token> route.
# ⚠️ The tunnel is NOT scoped to the Twilio routes: scripts/ngrok-launch.sh runs
# `ngrok http 5001`, which publishes EVERY route on :5001 — the TeamWork
# webhook, /teamwork/*, /plugins/*, /api/users/* included — and Prax applies no
# authentication of its own to those routes (the network is the boundary;
# docs/security/network-exposure.md lists exposing :5001 as an anti-pattern).
# Only set this if you accept that exposure or put a path-allowlisting proxy
# between ngrok and Prax. Empty/unset = ngrok stays off.
NGROK_AUTHTOKEN=your-ngrok-authtoken

# ── Tailscale sidecar (optional, recommended for remote access) ───────
# Runs `tailscaled` inside Docker so your server's host network never has
# to expose Prax — your laptop reaches the stack over the tailnet only.
#
# 1. Get a key from https://login.tailscale.com/admin/settings/keys
#    Pick: Reusable ✓, Ephemeral ✗, Pre-approved ✓
#    (Ephemeral keys count against the free tier's 1,000-min/month minute
#    budget — non-ephemeral keys do not.)
# 2. Uncomment both lines below.
# 3. `docker compose up -d` — sidecar starts automatically.
#
# Without COMPOSE_PROFILES=tailscale the sidecar is silently skipped, so
# leaving these commented is the same as not having it.
#TS_AUTHKEY=tskey-auth-xxxxxxxxxxxxxxxx
#TS_HOSTNAME=prax
#COMPOSE_PROFILES=tailscale
#TS_EXTRA_ARGS=--accept-dns=false

# ── Sandbox (coding/browser/desktop environment — the prax-sandbox repo) ──
# Master switch. Leave true (default) for the full experience. Set false to
# run Prax as a pure harness with NO sandbox tools, spokes, or container
# dependency. The sandbox itself lives in the sibling prax-sandbox repo.
#SANDBOX_ENABLED=true
# The sandbox image no longer ships a coding-agent server (OpenCode) or model
# keys — Prax codes DIRECTLY (run_python / workspace_save|patch / source_read|grep
# / sandbox_shell). The delegate_sandbox spoke runs headless code execution with
# those direct tools; there is no coding-session flag to set.
#
# Known gap (2026-09): the sandbox IMAGE is keyless, but prax's own
# docker-compose.yml and docker-compose.lite.yml still pass ANTHROPIC_API_KEY /
# OPENAI_API_KEY (from the *_KEY values below) into the `sandbox` service and
# mount this repo at /source. Only the sibling prax-sandbox compose is keyless.
# Any code-exec tool can `printenv` whatever the container is given.
#
# Container wiring — docker-compose sets SANDBOX_HOST=sandbox, `make run-local-*`
# sets SANDBOX_HOST=localhost (published loopback ports); defaults shown.
# SANDBOX_IMAGE=prax-sandbox:latest
# SANDBOX_HOST=localhost
# Session-policy values forwarded into the sandbox client config
# (prax/services/sandbox_bridge.py); nothing else in prax reads them. Leave them
# at the defaults.
# SANDBOX_TIMEOUT=1800
# SANDBOX_MAX_CONCURRENT=5
# SANDBOX_DEFAULT_MODEL=openai/gpt-5.4
# SANDBOX_MAX_ROUNDS=10
# Declared but NOT consumed by any code today (no compose file or client reads
# them) — the container runs with Docker's default, unlimited resources:
# SANDBOX_MEM_LIMIT=1g
# SANDBOX_CPU_LIMIT=2000000000
# Set by docker-compose.yml for the container, NOT for host installs (leave it
# unset there). Known gap (2026-09): prax/utils/shell.run_command routes
# commands into the sandbox ONLY when this is true, so on a host install the
# desktop_* tools and plugin caps.run_command execute on the Prax host itself.
# RUNNING_IN_DOCKER=false
#
# REMOTE sandbox (optional): leave SANDBOX_DAEMON_URL empty to use a local
# in-process sandbox. Set it to drive a sandbox on another box via the
# control daemon (TLS + bearer). See ../prax-sandbox/docs/remote.md.
#SANDBOX_DAEMON_URL=https://sandbox-host:8843
#SANDBOX_DAEMON_TOKEN=
#SANDBOX_TLS_VERIFY=true              # true | false | path to a CA bundle
#   `false` disables certificate AND hostname checks for a bearer the sandbox
#   docs call root-equivalent on that box (../prax-sandbox/docs/remote.md) —
#   never use it across a link you don't fully trust; prefer a CA-bundle path.
#SANDBOX_CLIENT_CERT=                 # opt-in mTLS
#SANDBOX_CLIENT_KEY=
#
# Lean 4 proof-check tool (lean_check in the sandbox spoke). Compiles Lean
# source in the sandbox + runs the axiom-audit trust gate. Needs the Lean
# toolchain in the sandbox image — rebuild prax-sandbox after enabling.
# Assessment: docs/research/cdc-lean-teach-prax-lean.md
#LEAN_TOOLS_ENABLED=false

# Git repositories attached to a Library space (space_repo_* tools, default
# off). Lets Prax read the code the work is about. Off by default because
# attaching a repo hands the agent a credential and a checkout. Each attachment
# gets its own ed25519 deploy key (scoped to ONE repo), and pushing needs a
# second, per-repository decision that starts off regardless of this flag.
# Docs: docs/security/space-git-repos.md
#SPACE_REPOS_ENABLED=false

# data_query tool (default off): DuckDB SQL / number-crunching over
# CSV/Parquet/JSON in the sandbox. Needs duckdb + pandas in the sandbox image
# (installed into /opt/prax-venv) — rebuild prax-sandbox after enabling.
#DATA_TOOLS_ENABLED=false

# OpenAI / AI Providers
OPENAI_KEY=sk-xxxx
ANTHROPIC_KEY=sk-ant-xxxx
# Cheap/prepaid evals: point the OpenAI-compatible client at a third-party
# provider (OpenRouter/DeepSeek/Groq). Set OPENAI_KEY to that provider's key.
# Prepaid balance = a huge bill is impossible. See docs/guides/cheap-evals.md.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1   # or https://api.deepseek.com
#
# OpenRouter — the easiest cheap-eval path. Put your key here, then run any eval
# with `make eval CHEAP=1` (all tiers → one cheap OpenRouter model, prepaid). The
# key alone does NOT redirect production; you opt in per-run. See cheap-evals.md.
# OPENROUTER_API_KEY=sk-or-xxxx
# Optional: route the eval path through the keyless secrets-proxy instead of
# hitting OpenRouter direct. Leave unset for direct (needs a real key above); set
# to the proxy to run evals with only a placeholder key on the box. Without one of
# these, fresh eval calls fail 401 (the bug that voided the first matrix baseline).
# The REVERSE proxy listens on :8785 and routes /<provider>/..., so the OpenRouter
# leg is its `openai` provider with PROXY_OPENAI_BASE_URL=https://openrouter.ai/api/v1
# set in the proxy's own .env. (:8786 is the forward/MITM proxy — used via
# HTTPS_PROXY, never as a base URL; see docs/security/deployment-topology.md.)
# OPENROUTER_BASE_URL=http://127.0.0.1:8785/openai
#
# ── TWO WAYS to give Prax model keys ──────────────────────────────────────────
# (A) Keys-in-Prax (above): simplest, works out of the box. FINE for trusted/solo
#     use. NOTE: Praxagent ENDORSES path (B) for security, and path (A) is planned
#     for DEPRECATION in a future release — prefer (B) for new/hardened deployments.
#
# (B) KEYLESS Prax via the secrets-proxy (ENDORSED) — the real keys live in a
#     separate, isolated service so a compromised/injected Prax has nothing to
#     steal. Run the proxy from its own repo (https://github.com/praxagent/prax-
#     secrets-proxy), then here point the base URLs at it and set the two keys
#     above to the proxy's ACCESS TOKEN (the proxy validates the token, then swaps
#     it for the real key). See docs/security/secrets-proxy.md.
# OPENAI_BASE_URL=http://127.0.0.1:8785/openai
# ANTHROPIC_BASE_URL=http://127.0.0.1:8785/anthropic
#   then set OPENAI_KEY and ANTHROPIC_KEY (above) to the proxy's PROXY_AUTH_TOKEN.
#   Known gap (2026-09): only the LLM factory (prax/agent/llm_factory.py) applies
#   OPENAI_BASE_URL from settings. Several features construct `OpenAI(api_key=...)`
#   directly with no base_url — TTS/Whisper (prax/plugins/capabilities.py), YouTube
#   transcription (prax/services/youtube_service.py), space cover images
#   (prax/services/library_service.py), the image plugin and the LaTeX readers. The
#   openai SDK only falls back to OPENAI_BASE_URL when it is in the PROCESS
#   environment (docker-compose `env_file: .env` does that; a host install whose
#   .env is read by pydantic does not), so in a host-process keyless setup those
#   features send the proxy token to api.openai.com and fail 401.
#   With TLS on the proxy: use https:// URLs and set SSL_CERT_FILE to the proxy cert:
# SSL_CERT_FILE=/abs/path/to/prax-secrets-proxy/certs/proxy.crt
#   In keyless mode ALSO declare that the base URL fronts REAL OpenAI (the proxy
#   is a path-agnostic pass-through) — without this, a custom base URL is treated
#   as a third-party provider: plain chat-completions only, which discards
#   private reasoning after every tool call and 404s -pro/o-series models.
#   Set this whenever the base URL fronts real OpenAI — it is a CORRECTNESS
#   requirement, not a tuning knob:
# OPENAI_BASE_URL_IS_OPENAI=true
#
#   Reasoning retention (previous_response_id chaining, the ChatGPT/Codex
#   production setting) is SEPARATE and stays off by default. We A/B'd it —
#   3 runs per arm on the capability suite with o4-mini — and measured NO
#   effect on task success (identical means) and a token reduction that was
#   consistent in direction but not statistically established (p=0.125, n=3).
#   Enable it if you want to test it on your own workload; don't expect the
#   vendor's headline numbers. Full result:
#   docs/research/retained-reasoning-ab-2026-08-02.md
# OPENAI_RETAIN_REASONING=true
AGENT_NAME=Prax
LLM_PROVIDER=openai
AGENT_TEMPERATURE=0.7

# Temperature for LLM surfaces that GRADE rather than generate — eval judges,
# the self-regen accept-gate auditor. These used to inherit AGENT_TEMPERATURE
# (the knob tuned for generation), which made verdicts stochastic: the same
# answer could be graded pass on one run and fail on the next, so a published
# eval number was not reproducible. Graders should be as close to
# deterministic as the model allows. Generators (the self-regen proposer, the
# multi-turn user simulator) are deliberately left warm.
JUDGE_TEMPERATURE=0.0

# Independent ballots per judged rubric criterion; the verdict is the strict
# majority (a tie falls to 0 — a split panel is not a satisfied criterion).
# Temperature 0.0 removed the CONFIGURED randomness but not the provider's: the
# 2026-08-20 bias audit re-graded one answer five times at temperature 0.0 and
# watched 3 of 5 criteria flip, with a golden's total swinging 0.20-0.65.
# Voting is the model-agnostic remedy (a provider `seed` is OpenAI-only and
# best-effort; the ladder runs DeepSeek/GLM through OpenRouter). Default 1 is
# exactly the previous behaviour. Costs k x judge tokens, and raising it
# RE-BASELINES every published number — change it deliberately.
# See docs/guides/judge-audit.md.
JUDGE_VOTES=1
ELEVENLABS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model Tiers — provider-agnostic intelligence levels.
# Prax defaults to LOW and upgrades when needed.  ENABLED_TIERS lists the tiers it may use.
# For Anthropic: LOW=haiku, MEDIUM=sonnet, HIGH=opus, PRO=opus
# For local/vllm: set all to your local model name
BASE_MODEL=gpt-5.4-nano
ENABLED_TIERS=low,medium,high
LOW_MODEL=gpt-5.4-nano
MEDIUM_MODEL=gpt-5.4-mini
HIGH_MODEL=gpt-5.5
PRO_MODEL=gpt-5.5-pro
# Deprecated per-tier switches — ENABLED_TIERS replaced them (docs/guides/flag-audit.md).
# A legacy var still wins when set explicitly (and logs a deprecation warning);
# leave them unset in new deployments.
# LOW_ENABLED=
# MEDIUM_ENABLED=
# HIGH_ENABLED=
# PRO_ENABLED=

# Per-component tier/model/provider overrides (optional).
# These override the defaults in prax/plugins/configs/llm_routing.yaml
# without touching any config files — useful for per-deployment tuning.
# Convention: {COMPONENT}_{KEY} in UPPER_CASE.
# Examples:
#   ORCHESTRATOR_TIER=high           # upgrade the main agent loop
#   SUBAGENT_RESEARCH_TIER=medium    # downgrade research to save cost
#   SUBAGENT_BROWSER_PROVIDER=anthropic  # use Claude for browser spoke
#   ORCHESTRATOR_TEMPERATURE=0.5     # lower creativity for the main loop
# Available components: orchestrator, subagent_research, subagent_knowledge,
#   subagent_browser, subagent_course, subagent_sandbox, subagent_sysadmin,
#   subagent_finetune, subagent_memory, subagent_workspace, subagent_scheduler
# Available keys: TIER, MODEL, PROVIDER, TEMPERATURE

# Vision / Image Understanding
# Provider-agnostic: set VISION_PROVIDER to openai, anthropic, or google.
# The model is passed to that provider's API and must be a vision-capable CHAT
# model — image-GENERATION models (gpt-image-*) 500 on analysis calls. Examples:
#   OpenAI:    gpt-5.4-mini
#   Anthropic: claude-sonnet-4-20250514 (or any vision-capable Claude model)
#   Google:    gemini-2.0-flash
VISION_MODEL=gpt-5.4-mini
# Image GENERATION model (distinct from VISION_MODEL analysis) — builtin generate_image + Library covers
IMAGE_MODEL=gpt-image-1
VISION_PROVIDER=openai

# Local vision model (optional) — point analyze_image at any
# OpenAI-compatible server (llama.cpp llama-server, vLLM, Ollama, LM Studio).
# When VISION_BASE_URL is set, Prax inlines images as base64 data URIs so the
# local server doesn't need outbound network access to the Discord/Twilio CDN.
# VISION_API_KEY is optional — most local servers ignore it.
# Example (llama.cpp llama-server with --alias qwen-vl):
#   VISION_PROVIDER=openai
#   VISION_MODEL=qwen-vl
#   VISION_BASE_URL=http://localhost:8083/v1
# VISION_BASE_URL=
# VISION_API_KEY=

# ── Local / self-hosted LLM (optional; GPU NOT required) ────────────────────
# Point the chat/orchestrator LLM at any local or cloud OpenAI-compatible server
# (ds4 / llama.cpp / vLLM / Ollama). The `vllm` provider is just an OpenAI client
# against VLLM_BASE_URL — it needs no API key. GPU is optional: a high-RAM CPU box
# running a MoE model (few active params/token) is the cheap path for overnight
# evals. See docs/guides/local-cpu-inference.md (CPU/Mac/Spark sizing + engine
# setup), docs/guides/cloud-gpu.md, docs/guides/local-vision.md, and the eval
# overnight workflow in prax/eval/README.md.
#
# Example — antirez's ds4 (DeepSeek V4) serving its OpenAI-compatible endpoint:
# LLM_PROVIDER=vllm
# VLLM_BASE_URL=http://<ds4-host>:<port>/v1
# LOW_MODEL=deepseek-v4-flash
# MEDIUM_MODEL=deepseek-v4-flash
# HIGH_MODEL=deepseek-v4-flash
#
# Example — vLLM / Ollama / llama.cpp on a CPU box (MoE = fast on CPU):
# LLM_PROVIDER=vllm
# VLLM_BASE_URL=http://localhost:8000/v1
# LOCAL_MODEL=Qwen/Qwen3-8B
# For a SOVEREIGN / on-prem / EU-AI-Act deployment, serve an open model here —
# recommended: Apertus (https://apertvs.ai/, EU-compliant). Tool-calling fidelity
# on open backends is tracked, not assumed — IDEAS_BACKLOG #20.
# Fine-tuning (LoRA via Unsloth; GPU required). See docs/guides/local-vision.md.
# FINETUNE_ENABLED=false
# FINETUNE_BASE_MODEL=unsloth/Qwen3-8B-unsloth-bnb-4bit
# FINETUNE_OUTPUT_DIR=./adapters
# FINETUNE_MAX_STEPS=60
# FINETUNE_LEARNING_RATE=2e-4
# FINETUNE_LORA_RANK=16
# Cloud GPU power control (optional; the `gpu_power` plugin + examples/gpu-power-broker/).
# Least-privilege "on/off only": Prax holds ONLY a bearer token to a user-run
# power-broker, never a broad cloud cred. Unset GPU_POWER_BROKER_URL ⇒ the plugin
# registers no tools (fail-closed). See docs/guides/cloud-gpu.md + IDEAS_BACKLOG #16.
# GPU_PROVIDER=            # none | broker | aws | gcp
# GPU_POWER_BROKER_URL=
# GPU_POWER_BROKER_TOKEN=
# GPU_INSTANCE_ID=

# Auto-generate cover images for new spaces (uses OPENAI_KEY).
# Set to false to disable — spaces will use gradient placeholders instead.
# NOTE: not a settings.py field — prax/services/library_service.py reads it from
# os.environ, so it only takes effect when it is in the PROCESS environment
# (docker-compose env_file does that; under `make run-local-*` or the systemd
# unit a value here is NOT seen and the default, true, applies).
AUTO_GENERATE_COVER=true

# Flight Search (Amadeus API — free tier at https://developers.amadeus.com)
AMADEUS_API_KEY=
AMADEUS_API_SECRET=

# Jina AI Reader (https://jina.ai) — used by fetch_url_content,
# note_from_url, and SMS/Discord URL auto-capture for clean HTML→markdown
# extraction.  Works without a key on the free tier (lower rate limits,
# ~20 req/min).  Set this to upgrade to paid quota for higher throughput.
JINA_API_KEY=

# X / Twitter API v2 bearer token.  When set, x.com/twitter.com STATUS links are
# fetched via the API instead of the web reader (X locked down scraping, so the
# reader/browser path fails on tweets).
TWITTER_API=

# Enhanced tweet fetching: expand t.co links to real URLs and fetch the
# author's full self-thread (root + self-replies, in posting order) when the
# linked tweet is part of one.  Costs 1–2 extra API calls per tweet fetch and
# needs an X API tier with /2/tweets/search/recent access (Basic and up).  The
# search window is 7 days — older threads degrade to the single linked tweet.
# Only genuine self-threads are expanded (never another author's posts).
TWITTER_THREAD_FETCH=false

# Label fetch_url_content results with their true provenance: posts fetched via
# a platform's native API (X / Bluesky / Threads) get a SOCIAL POST tag — the
# text/links/handles/metrics are verbatim from the API, while claims inside the
# post stay the author's own (NOT verified) — plus a "(fetched via ...)" suffix,
# instead of being mislabeled as scraped web content.
URL_FETCH_SOURCE_TAGS=false

# Threads (Meta) Graph API access token.  threads.net post links are fetched via
# graph.threads.net.  Reading third-party public posts requires an app with
# Advanced Access for threads_basic; otherwise it falls back to the web reader.
THREADS_API=
# (Bluesky needs NO key — bsky.app posts use the open public AppView API.)

# Search / External APIs
# ⚠️ Google keys are best left UNSET. Google Cloud billing has NO hard spend cap, so a
# runaway loop or a prompt-injected agent could rack up unbounded charges. Prax works
# fine without them (keyless search providers + non-Google vision). Only set these
# behind a Google Cloud budget/quota cap you configured yourself. See
# docs/security/credentials.md.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
GOOGLE_VERTEX_PROJECT=my-project
GOOGLE_VERTEX_LOCATION=us-central1
NYT_USERNAME=user@example.com
NYT_PASSWORD=password

# Discord (free alternative to Twilio — set token to enable)
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USERS={"123456789012345678": "Alice"}
DISCORD_ALLOWED_CHANNELS=
# Link Discord users to phone numbers to share conversation history + workspace.
# Use your PERSONAL phone number (from PHONE_TO_NAME_MAP), NOT the Twilio ROOT_PHONE_NUMBER.
DISCORD_TO_PHONE_MAP={"123456789012345678": "+15551234567"}

# Agent Autonomy Level
# guided     = current behavior, prescriptive workflow rules, all safety gates
# balanced   = removes prescriptive workflow rules, agent uses judgment
# autonomous = also relaxes recursion limits, lets agent self-upgrade tier,
#              earned trust can downgrade browser tool risk levels
PRAX_AUTONOMY=balanced

# Workspace (git-backed per-user document storage)
# Default: ../workspaces (outside repo root to prevent accidental secret commits)
WORKSPACE_DIR=../workspaces

# User identity — REQUIRED for Docker deployments.
# The sandbox mounts only this user's workspace folder for isolation.
# Pick any slug (e.g. usr_alice, myworkspace). Prax will refuse to start
# without this when running in Docker.
# All sandbox-persistent data (browser profiles, desktop settings, coding
# agent configs) is stored inside {WORKSPACE_DIR}/{PRAX_USER_ID}/.sandbox/.
# Known gap (2026-09): on a FRESH identity DB this slug is not attached to the
# user TeamWork creates. Startup creates workspaces/<slug> from this value
# (app.py → prax/services/state_paths.py), the first TeamWork message creates
# the user under usr_<id8> (prax/services/identity_service.py:resolve_user), and
# the next restart's reconcile_workspace_dir() repoints that user to <slug>
# without a symlink because the directory already exists — data written in the
# first session stays behind in usr_<id8>/. Existing deployments are past this;
# on a new install check both directories before assuming loss.
PRAX_USER_ID=

# Browser (persistent profiles let Prax stay logged in to sites like x.com)
# By default, browser profiles are stored inside each user's workspace
# ({WORKSPACE_DIR}/{user_id}/.browser_profile/). Set BROWSER_PROFILE_DIR
# below to override with a shared location.
#BROWSER_PROFILE_DIR=./browser_profiles
#BROWSER_HEADLESS=true
#BROWSER_TIMEOUT=30000
#SITES_CREDENTIALS_PATH=./sites.yaml
# CDP endpoint — Playwright connects to this Chrome instead of launching its own.
# In docker-compose this is set automatically to the sandbox Chrome.
# Leave empty for local dev (Playwright will launch a standalone browser).
# Host-process deployments (make run-local-all): use the published loopback
# port instead: BROWSER_CDP_URL=http://localhost:9223
#BROWSER_CDP_URL=http://sandbox:9223

# Sandbox-only browsing: never run a Chromium on the harness host — keep the
# host dedicated to orchestration (browser rendering stays in the sandbox
# container).  When the sandbox Chrome is unreachable, browser tools report it
# as down instead of falling back to a locally-launched browser, and manual
# logins route to the TeamWork Browser panel instead of a host Xvfb/x11vnc
# session.  Requires BROWSER_CDP_URL to point at the sandbox CDP port.
BROWSER_SANDBOX_ONLY=false
# Run browser navigation URLs through the SSRF guard (refuse private/internal
# hosts) before Chromium loads them. Off by default: a personal assistant is
# legitimately asked to open localhost dev servers. file:// and other non-http
# schemes are refused regardless of this flag.
BROWSER_NAVIGATE_SSRF_GUARD=false

# Prax SSH Key — lets Prax push workspaces to a private remote
# Preferred: bind-mount the key file read-only (see README for docker-compose example)
# Fallback: base64-encode and paste below (env vars can leak in crash dumps, APM traces, etc.)
# 1. Generate a key:  ssh-keygen -t ed25519 -f ~/.ssh/prax_deploy_key -N "" -C "prax-workspace"
# 2. Add ~/.ssh/prax_deploy_key.pub as a deploy key with WRITE access on your repo
#    (GitHub: Settings → Deploy keys → Add deploy key)
# 3. Base64-encode the private key:  cat ~/.ssh/prax_deploy_key | base64 | tr -d '\n'
# 4. Paste the output below
PRAX_SSH_KEY_B64=
# Legacy plugin-repo settings (deprecated — use PRAX_SSH_KEY_B64 + workspace push;
# prax/plugins/repo.py still reads them when set).
# PLUGIN_REPO_URL=
# PLUGIN_REPO_SSH_KEY_B64=
# PLUGIN_REPO_BRANCH=plugins
# PLUGIN_REPO_LOCAL_PATH=./plugin_repo

# Self-Improvement — global gate for all self-modification capabilities.
# When enabled, Prax can modify his own code via PRs and deploy hot-fixes.
# When disabled, all self-modification tools are hidden from the agent.
SELF_IMPROVE_ENABLED=false
# Preferred coding-agent CLI name for self-improvement tasks
# (claude-code | codex | opencode). The sandbox image no longer ships any of
# these CLIs (../prax-sandbox/sandbox/Dockerfile removed them on purpose); a user
# who wants one installs it in the sandbox themselves, with its own key.
# WARNING: they use provider API tokens and cost money per invocation.
SELF_IMPROVE_AGENT=claude-code
# Repo the self-improve flow operates on (default: the process working directory).
# SELF_IMPROVE_REPO_PATH=
# Author identity for the git commits Prax makes in workspaces and self-improve
# branches (prax/services/workspace_service.py, prax/services/codegen_service.py).
# GIT_AUTHOR_NAME=Prax
# GIT_AUTHOR_EMAIL=prax@localhost

# Memory System (vector store + knowledge graph for long-term memory)
# Qdrant and Neo4j are bundled INSIDE the prax container image (they are not
# separate compose services); `make run-local-all` starts them as standalone
# Docker containers instead.
# Set to false to disable memory even when the services are available.
MEMORY_ENABLED=true
QDRANT_URL=http://localhost:6333
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=prax-memory
# Embedding model — used for semantic memory search
#EMBEDDING_PROVIDER=openai
#EMBEDDING_MODEL=text-embedding-3-small

# Embedding provider — used for semantic memory search.
# Default: OpenAI (cheapest option, ~$0.02/M tokens, no extra RAM).
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# For local embeddings with Ollama (no data sent to OpenAI, but ~1.5GB extra RAM):
#   docker compose --profile local-llm up
#   EMBEDDING_PROVIDER=ollama
#   EMBEDDING_MODEL=nomic-embed-text
#   OLLAMA_BASE_URL=http://ollama:11434
#
# For fully local (fastembed, in-process, no external service):
#   EMBEDDING_PROVIDER=local
#
# For any OpenAI-compatible local /v1/embeddings server (vLLM, llama.cpp server,
# LM Studio, SIE): keep EMBEDDING_PROVIDER=openai and point the base URL at it.
# No OPENAI_KEY needed — local servers accept a placeholder.
#   EMBEDDING_BASE_URL=http://localhost:8080/v1
OLLAMA_BASE_URL=http://localhost:11434
# Consolidation interval in seconds (3600 = hourly).
# Known gap (2026-09): nothing reads this setting — consolidation is triggered
# every 5 turns by a hard-coded counter in prax/services/memory_service.py.
MEMORY_CONSOLIDATION_INTERVAL=3600
# Ebbinghaus decay half-life in days (memories lose half their importance)
MEMORY_DECAY_HALFLIFE_DAYS=7.0
# Symbolic consistency pass at consolidation (docs/research/neurosymbolic-lens.md).
# For relation types declared single-valued, ask the GRAPH whether a conflicting
# current edge exists rather than trusting the extractor LLM to volunteer
# "supersedes".
#   off     — prior behaviour (LLM-volunteered supersession only)
#   log     — detect and log conflicts, change nothing. Run here first: the
#             single-valued list is authored, and a wrong entry would make
#             "enforce" a fact-deleter.
#   enforce — also close the stale edge (valid_until=now)
MEMORY_CONSISTENCY_MODE=off

# NOTE: provenance-marker tainting (docs/security/provenance-laundering.md) has
# no flag of its own — stored external captures re-entering the context are
# bannered as untrusted regardless of which tool read them. It lives in the
# UntrustedContentTaint middleware (prax/agent/loop_middleware.py), so it is
# active whenever AGENT_MIDDLEWARE_ENABLED is true (the default); setting that
# flag to false switches the marker banners off with the rest of the middleware.
# Max STM entries before LLM compaction triggers
MEMORY_STM_MAX_ENTRIES=50

# Observability (OTel tracing, Prometheus metrics, Grafana dashboards)
# Set to true and start the observability profile to get the full stack:
#   docker compose --profile observability up
# Prax safely degrades if the profile isn't active (no OOM, no retries).
OBSERVABILITY_ENABLED=true
GRAFANA_URL=http://localhost:3002
# Datasource endpoints for the obs_* agent tools (prax/services/obs_service.py);
# empty by default.
# LOKI_URL=
# PROMETHEUS_URL=
# TEMPO_URL=

# Health Monitoring Watchdog
# Periodic self-checks every N turns — detects tool error spikes, context
# overflows, latency degradation, spoke failures, and recent code changes.
# Disable for minimal RAM / lightweight deployments.
HEALTH_MONITOR_ENABLED=true

# Task runner — background worker that picks up Library Kanban / todo items
# assigned to Prax and runs each as a synthetic orchestrator turn. Opt-in: it
# spends model tokens with no user in the loop.
# TASK_RUNNER_ENABLED=false
# TASK_RUNNER_INTERVAL_MINUTES=5

# TeamWork (web UI — Slack-like interface for Prax)
# TEAMWORK_URL below IS the switch: set it and Prax connects; leave it empty and
# Prax runs standalone. (TEAMWORK_ENABLED is deprecated — it was a second gate on
# the same thing, and that redundancy was the "URL set but silently skipped"
# trap. Setting it to false still forces TeamWork off if you rely on that.)
# e.g. http://localhost:8000 — a host install, and also inside the bundled
# container, where scripts/watchdog-launch.sh defaults it to that. `make
# run-local-all` passes TEAMWORK_URL=http://localhost:8000 itself.
TEAMWORK_URL=
# TEAMWORK_ENABLED=      # deprecated; only an explicit false still has an effect
# Set TEAMWORK_PATH to the teamwork repo if it's not at ../teamwork
#TEAMWORK_PATH=../teamwork
# Shared key for TeamWork's external agent API. REQUIRED whenever TEAMWORK_URL is set:
# TeamWork returns 503 if it has no credential configured, so Prax can't post.
# Generate:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Set the SAME value as EXTERNAL_API_KEY in teamwork/.env — they must match
# (mismatch = 401 Invalid API key).
# Direction: Prax only SENDS this key (X-API-Key on its calls to TeamWork's
# /api/external). It does NOT check it on inbound requests — Prax's own
# /teamwork/* webhook and routes accept any caller that can reach :5001, so this
# key is not an auth boundary for Prax (see docs/security/network-exposure.md).
TEAMWORK_API_KEY=

# Inbound counterpart (default-off). When set, Prax's own /teamwork/*, /plugins/*
# and /api/users/* routes require a matching `X-API-Key` header and fail closed;
# TeamWork sends it when its PRAX_API_KEY is set to the same value. Empty = no
# inbound check (prior behaviour — the network perimeter is the only control).
#PRAX_API_KEY=
# Map TeamWork messages onto an existing SMS identity so web chat shares history
# and workspace with SMS/Discord. Empty = a dedicated "teamwork" user.
# TEAMWORK_USER_PHONE=
# User-facing base URL for course/note links Prax surfaces in chat.
# Defaults to the local Docker port mapping (works for localhost + SSH tunnel).
# You usually DON'T need to set this: when it's unset/localhost, Prax
# auto-derives the public URL from the live deployment (Tailscale MagicDNS /
# ngrok), so links work off-network without editing .env.  Set it explicitly
# only to force a specific URL (an explicit non-local value always wins).
#TEAMWORK_BASE_URL=http://localhost:8000
# Auto-derive the public base URL for links from Tailscale/ngrok (default true).
# Set false for strict config-only behaviour (use TEAMWORK_BASE_URL verbatim).
#PUBLIC_URL_AUTODETECT=true

# Phone metadata (JSON strings)
PHONE_TO_NAME_MAP='{"+15551234567": "Example User"}'
PHONE_TO_EMAIL_MAP='{"+15551234567": "user@example.com"}'
PHONE_TO_GREETING_MAP='{"+15551234567": "greeting_example.mp3"}'

BROWSER_VNC_ENABLED=true
# First VNC display port; each browser session offsets from it.
# BROWSER_VNC_BASE_PORT=5900

# ─────────────────────────────────────────────────────────────────────
# Reliability & quality (2026-06) — flag-gated; most code defaults are OFF so the
# harness behaves as before unless you opt in (exceptions are called out per flag
# below, e.g. the two eval-gated flags whose defaults flipped on 2026-08-07).  The
# values below are
# the RECOMMENDED configuration per the first eval-gate run (2026-07-08, every
# flag A/B'd against baseline — verdicts, method, and caveats in
# docs/research/flag-eval-campaign-2026-07-08.md; flag rationale in
# docs/research/reliable-agentic-systems-bayer.md).
# ─────────────────────────────────────────────────────────────────────

# Cross-provider LLM failover: on a provider-side failure (rate limit,
# overload, connection error, OPEN breaker) transparently retry on another
# provider instead of surfacing the error.  Chain auto-derives from
# configured providers if LLM_FALLBACK_CHAIN is empty.
LLM_FALLBACK_ENABLED=false
#LLM_FALLBACK_CHAIN=anthropic:claude-sonnet-4-20250514,google:gemini-2.5-pro
# When failover is on, a *terminal* provider failure (auth / billing / access /
# decommissioned — which a retry won't fix) denylists that provider from the
# pool and tells the user the likely cause (e.g. a late bill or revoked key),
# instead of re-hitting it every turn.  Re-probed after the cooldown (0 = until
# restart).  No effect when LLM_FALLBACK_ENABLED is off.
LLM_PROVIDER_DENYLIST_ENABLED=true
#LLM_PROVIDER_DENYLIST_COOLDOWN_SECONDS=1800
# Backoff (ms, ±25%% jitter) before a failover retry so a shared transient blip
# doesn't become a retry storm across the chain. 0 (default) = immediate.
#LLM_FAILOVER_BACKOFF_MS=0
# Detect SILENT model substitution: warn (log + telemetry) if the model that
# actually answered differs from the one requested. Off by default (observability
# only, no behaviour change). See docs/research/failure-atlas-llm-gateways.md.
#LLM_RECORD_ANSWERING_MODEL=false

# Inject the structured failure diagnosis back into the retry so the model
# re-plans with it in context (on by default — error-path only).
RECOVERY_CONTEXT_INJECTION=true

# Durable checkpoints (resume a crashed/timed-out turn across restarts) +
# user-initiated resume of a failed turn (skips completed steps).
CHECKPOINT_BACKEND=memory          # or: sqlite (durable — needed for resume across restart)
# NOTE: the sqlite backend needs the `langgraph-checkpoint-sqlite` package, which
# is NOT in pyproject.toml; without it prax/agent/checkpoint.py logs a warning and
# silently falls back to in-memory (docs/architecture/lang-stack.md).
#CHECKPOINT_DB_PATH=.prax/checkpoints.sqlite
CHECKPOINT_RESUME_ENABLED=false
#CHECKPOINT_RESUME_TTL=3600
# Resumable-pointer state file (only used when resume is enabled). To discard
# all pending resumes: delete this file, or set CHECKPOINT_RESUME_ENABLED=false.
#CHECKPOINT_RESUME_STATE_PATH=.prax/resumable.json

# Continuous evaluation: nightly reference-free scoring of sampled traces →
# Prometheus (prax_eval_quality).  `make eval` runs the regression gate.
EVAL_NIGHTLY_ENABLED=false
#EVAL_NIGHTLY_SAMPLE_SIZE=25
#EVAL_NIGHTLY_CRON=0 4 * * *
# Golden-suite AUDITOR: a high-tier judge re-checks the criteria the cheap judge
# passed and may veto vacuous answers. Eval-time only.
# EVAL_AUDITOR_ENABLED=false

# Benchmark suites (make eval-capability / eval-harness-lift / eval-gaia).
# PRAX_EVAL_DIR auto-defaults to a repo-sibling `prax-evals/` (override to relocate
# the isolated, out-of-repo run data). PRAX_EVAL_TASK_TIMEOUT_S=0 means NO per-task
# wall-clock kill — the right default for a slow local model run overnight; set a
# positive value only as a safety rail. USD rates default to 0 (a local model has
# no per-token cost; runs are ranked by tokens + wall-time).
#PRAX_EVAL_DIR=/abs/path/to/prax-evals
# Hugging Face READ-ONLY token, used only when fetching gated eval datasets such
# as GPQA-Diamond (scripts/fetch_eval_datasets.py, prax/eval/benchmarks/datasets.py);
# never at agent runtime.
# HF_TOKEN_RO=
#PRAX_EVAL_TASK_TIMEOUT_S=0
#PRAX_EVAL_CONCURRENCY=1
#PRAX_EVAL_USD_IN_PER_1M=0
#PRAX_EVAL_USD_OUT_PER_1M=0
# Self-rate-limiting for benchmark runs (prax/eval/rate_limit.py). A prepaid
# endpoint under load returns transient failures — connect timeouts, 429s, empty
# answers — which otherwise score as WRONG and deflate the number. Each per-case
# call retries transient failures with exponential backoff + jitter, and can pace
# itself with a min interval between calls. Defaults: retries on, throttle off.
#PRAX_EVAL_LLM_MAX_RETRIES=4          # retry attempts on transient failure (0 disables)
#PRAX_EVAL_LLM_BACKOFF_BASE_S=2.0     # backoff base; delay = base * 2^attempt (full jitter)
#PRAX_EVAL_LLM_BACKOFF_CAP_S=30.0     # max backoff delay
#PRAX_EVAL_LLM_MIN_INTERVAL_S=0.0     # min seconds between call starts (>0 = throttle)
# Self-regeneration loop (#29): `make eval-self-regen` proposes a system-prompt
# overlay, verifies it against the capability suite, keeps iff it improves AND the
# anti-spike overseer approves. Propose-only by default; set this true + pass
# APPLY=1 to let it auto-apply the winner (graded autonomy). Verifier + overseer
# always live outside the editable surface.
SELF_REGEN_ENABLED=false

# Retrieval precision: paraphrase/HyDE query expansion + LLM-judge rerank (memory),
# plus hybrid vector+keyword knowledge-graph concept search (default ON; degrades
# to substring when Qdrant is unavailable). Backfill old concepts with
# knowledge_graph.reindex_user_concepts(user_id).
# Eval gate 2026-07-08: DEFERRED — the capability suite has too little
# retrieval coverage to measure lift, and these add LLM calls per query;
# needs a purpose-built retrieval eval before recommending.
RETRIEVAL_QUERY_EXPANSION=false
#RETRIEVAL_QUERY_EXPANSION_N=3
RETRIEVAL_RERANK=false
#RETRIEVAL_RERANK_CANDIDATES=20
KNOWLEDGE_HYBRID_ENABLED=true

# Context engineering: shrink the base system prompt on simple turns +
# a cheap pre-flight clarifying-question gate for ambiguous/risky requests.
# Eval gate 2026-07-08 flipped selectivity ON citing ~2% fewer tokens; the
# 2026-08-07 campaign re-measured it against a NULL ARM and a per-case metric
# and found the saving is ~10.5% (turning it off costs +11.8%), roughly 25x the
# 0.45% noise floor. The July figure was diluted by an outlier case; the flag is
# a much bigger win than it was flipped for. Now default-ON in code too.
# Intent clarification measured +11% tokens with NO pass-rate gain and has been
# REMOVED. See docs/research/eval-scorer-audit-2026-08-07.md.
PROMPT_SELECTIVITY_ENABLED=true

# Tool economy: answer from knowledge when a question needs no external info,
# instead of over-fetching on closed-book turns until they balloon and time out.
# A counterweight to the persistence/"try another source" persona. Default off
# pending an eval-gate A/B (closed-book benchmarks + capability suite).
TOOL_ECONOMY_ENABLED=false

# Budget-aware answering: reason efficiently and COMMIT your conclusion within budget
# instead of spiralling until the turn times out with nothing. Honesty-preserving —
# the conclusion may be an honest "I don't know"; it never rewards a fabricated guess,
# so it doesn't spike multiple-choice. Default off pending an eval-gate A/B.
BUDGET_AWARE_ANSWERING_ENABLED=false

# Verify-discipline: verify a load-bearing, tool-checkable claim (a calculation,
# symbolic result, code output, lookup) WITH the tool, not mental arithmetic — and
# ONCE, not repeatedly. Complements budget-aware (commit) + tool-economy (don't
# over-fetch). Default off pending an eval-gate A/B + trace-grade check.
# Design: docs/research/verify-and-commit-discipline.md
VERIFY_DISCIPLINE_ENABLED=false

# Tool boundaries + transparency: deny-by-default risk for unrecognised
# tools; scope a HIGH-risk confirmation to just the confirmed tool; surface
# claim-audit warnings on attended replies (not only the Auditor channel).
# Eval gate 2026-07-08: deny-by-default REGRESSED correctness (blocked a needed
# tool; a capability case failed) and has been REMOVED. Scoped confirm survives:
# it NARROWS what a confirmation unlocks and was never tested independently of
# deny-by-default, so the regression does not implicate it.
HIGH_RISK_SCOPED_CONFIRM=false

# Govern spoke-internal tools (HIGH-risk confirmation gate + trifecta escalation
# INSIDE spokes, where every HIGH tool actually lives). Recording is always on;
# this switches on enforcement. Default off until the eval gate approves the flip.
SPOKE_GOVERNANCE_ENABLED=false
# Serialise turns per user (a follow-up message while Prax is still working no
# longer shares the in-flight turn's checkpoint slot/budget). Default off.
TURN_LOCK_PER_USER=false
CLAIM_AUDIT_ATTENDED_QUARANTINE=false
# Lethal-trifecta guard: once a turn ingests UNTRUSTED content + reads PRIVATE
# data, escalate EXTERNAL-SINK tools to HIGH (confirmation) — the architectural
# defense against indirect prompt-injection exfiltration. Default off.
LETHAL_TRIFECTA_GUARD=false
# In-loop agent middleware (prax/agent/loop_middleware.py): provenance-taint
# untrusted-source tool results INSIDE the loop before they re-enter the
# model's context, and touch the trace heartbeat on every model step — the
# in-loop counterpart to the perimeter governance wrapper.
# Eval gate 2026-07-08 flipped this ON citing ~7% fewer tokens. The 2026-08-07
# campaign re-measured against a null arm: middleware-ON actually costs ~0.5%
# MORE, not 7% less — the July figure was an artifact of averaging over one
# 111k-token outlier case. The flip still stands, but on no-regression +
# injection defence-in-depth ONLY; there is no cost argument for it.
# See docs/research/eval-scorer-audit-2026-08-07.md.
# The code default is also true since 2026-08-07 (docs/guides/flag-audit.md);
# false is a legitimate debugging setting — note it also switches off the
# provenance-marker taint (see the memory section above).
AGENT_MIDDLEWARE_ENABLED=true

# Tool memoization (default off): within one turn, an identical repeat of a pure,
# side-effect-free READ (web search/fetch, memory/workspace/conversation/trace
# lookups) returns the prior result instead of re-executing. Correct by
# construction — per-turn cache, idempotent reads only (run_python/shell/writes/
# browser navigation never memoized). The structural "verify once" efficiency
# lever. Grade with the trace-grade before flipping.
#TOOL_MEMOIZE_ENABLED=false

# SSRF egress guard (default ON): blocks outbound HTTP from the plugin gateway
# and URL reader to private/loopback/link-local hosts + the cloud metadata
# endpoint (169.254.169.254). Add dev hosts to the allowlist if you self-host a
# service the agent should reach (e.g. a local Qdrant). See docs/security/.
SSRF_PROTECTION_ENABLED=true
#SSRF_ALLOWED_HOSTS=localhost,127.0.0.1

# MCP server (default OFF): expose a curated, bearer-gated subset of Prax tools
# to OTHER agents over the Model Context Protocol (POST /mcp). Fail-closed — the
# endpoint only mounts when at least one client is configured. HIGH-risk tools
# are never exposed. See docs/infrastructure/mcp-server.md.
MCP_SERVER_ENABLED=false
# Single-caller shortcut: one token → one identity → MCP_TOOL_ALLOWLIST (or the
# read-only default set).
#MCP_BEARER_TOKEN=
#MCP_USER_ID=
#MCP_TOOL_ALLOWLIST=get_current_datetime,memory_recall,knowledge_search
# Per-caller registry: each token maps to its own user_id + tool allowlist (this
# is how you grant write tools to a specific trusted caller). JSON:
# {"clients":[{"name","token"|"token_sha256","user_id","allow":[...]|"default",
#  "expires_at":"2026-12-31T00:00:00Z"}]}  (expires_at optional)
#MCP_CLIENTS_PATH=/secrets/mcp_clients.json
# Token expiry (default OFF): when on, enforce the optional per-client
# "expires_at" (ISO-8601) above, plus MCP_TOKEN_EXPIRES_AT for the single-token
# client. Expired tokens are rejected exactly like invalid ones. Issue
# short-lived tokens to other agents and let them lapse instead of rotating.
#MCP_TOKEN_EXPIRY_ENABLED=false
#MCP_TOKEN_EXPIRES_AT=2026-12-31T00:00:00Z

# Public share-link TTL (default OFF): when on, every new public share
# (workspace_share_file + course/note publish) gets an expiry stamped at
# creation and 404s once past it (purged from the registry on the next listing).
# Re-publishing a course/note renews its lease. Shares created while OFF have no
# expiry and live until explicitly revoked.
#SHARE_LINK_TTL_ENABLED=false
#SHARE_LINK_TTL_SECONDS=604800   # 7 days

# Auto tier escalation: when a turn hits the tool-call recursion limit, rebuild the
# orchestrator one tier up and retry (turn-local). Code default false.
AUTO_TIER_ESCALATION=true
# AUTO_TIER_ESCALATION_CEILING=high   # low | medium | high | pro

# Agent guardrails (code defaults shown).
# AGENT_MAX_TOOL_CALLS=40            # tool-call steps per user message (main agent)
# AGENT_MAX_DELEGATION_DEPTH=4       # orchestrator → spoke → sub-agent nesting cap
# AGENT_RUN_TIMEOUT=300              # idle seconds with no heartbeat before a run is abandoned
# AGENT_RUN_MAX_TIMEOUT=1800         # hard wall-clock cap per run even with heartbeats
# LLM_REQUEST_TIMEOUT=300            # per-call HTTP timeout to the LLM provider
# Follow-through enforcement (default ON): nudges the agent to actually take a
# step it merely offered, and never lets a plan-housekeeping ack be the reply.
# AUTONOMY_FOLLOWTHROUGH_ENABLED=true

# Steadying counsel: detect a spiral in flight and inject a calm, honest "pause and
# try a different route" into the loop (structural rescue for timeout-with-no-answer).
SPIRAL_RECOVERY_ENABLED=false

# Prefix caching: mark the system prompt as a cacheable block for providers that
# require an explicit client-side breakpoint (Anthropic `cache_control`). Every
# tool-calling round re-sends the system prompt, tool definitions and the whole
# history, so a 29-call turn pays for that prefix 29 times. OpenAI-compatible
# endpoints cache automatically and are unaffected — non-Anthropic requests pass
# through untouched, so this is a no-op there rather than a risk.
# Verify with `cached_tokens_in` in the trace before believing it helps.
PROMPT_CACHE_ENABLED=false

# Epistemic vigilance (default off): adds a system-prompt principle to verify a
# user's factual/health/safety premise before accepting it (anti-sycophancy).
# EPISTEMIC_VIGILANCE_ENABLED=false

# Verify published links (default off): after save_and_publish, HEAD/GET the note
# URL and annotate the result with a warning if it does not resolve. Never blocks.
# VERIFY_PUBLISHED_LINKS=false

# Scheduler misfire catch-up: how far back (seconds) to look for a cron fire that
# was missed while the process was down; a missed fire inside the window runs once
# at startup. 0 restores the old drop-the-fire behaviour.
# SCHEDULER_MISFIRE_GRACE_S=600
